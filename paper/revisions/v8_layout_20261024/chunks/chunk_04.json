2683,"tabId":"t.0"},"text":"200"}},{"insertText":{"location":{"index":22681,"tabId":"t.0"},"text":"100"}},{"insertText":{"location":{"index":22679,"tabId":"t.0"},"text":"25"}},{"insertText":{"location":{"index":22677,"tabId":"t.0"},"text":"0"}},{"insertText":{"location":{"index":22675,"tabId":"t.0"},"text":"Encoder"}},{"insertText":{"location":{"index":22673,"tabId":"t.0"},"text":"Method"}},{"updateTableCellStyle":{"tableRange":{"tableCellLocation":{"tableStartLocation":{"index":22670,"tabId":"t.0"},"rowIndex":0,"columnIndex":0},"rowSpan":1,"columnSpan":7},"tableCellStyle":{"backgroundColor":{"color":{"rgbColor":{"red":0.92156863,"green":0.9411765,"blue":0.96862745}}}},"fields":"backgroundColor"}},{"insertText":{"location":{"index":23250,"tabId":"t.0"},"text":"The gate helps most before any update. With updates, the picture is mixed. H3 was supported for DINOv2 (−0.015 [−0.021, −0.011], 28 of 30 tasks) and SigLIP (−0.021 [−0.029, −0.015], 28 of 30) but not for MAE (+0.001 [−0.005, +0.007], 16 of 30). Two further observations are descriptive. First, after updates RAID v7 had slightly lower error than RAID v8 for all three encoders (MAE 0.323 vs 0.341 at 25 updates): the gate's preference for retrieval, which helps without training, limits what head updates can add. Second, RAID v8 reached its lowest error within 25 to 100 updates and then rose slightly, while head-only fine-tuning changed little after 100 updates.\nEncoder tuning reached the lowest error: full fine-tuning 0.287 and LoRA 0.293 after 200 updates, against 0.316 for the best head method. It also costs more. One update cost 7.3 ms for the RAID v8 head, 52 ms for LoRA and 128 ms for full fine-tuning, and 200 updates took 1.3, 10.5 and 25.8 GPU-seconds (Figure 5). At 25 updates the three reached similar error (0.341, 0.335 and 0.341) after 0.17, 1.3 and 3.2 GPU-seconds. The one-time costs are shared by all methods: encoding all frames of the 30 final tasks with three encoders took 7.6 minutes, and training one source head took about 2.8 minutes on an A100.\n"}},{"updateTextStyle":{"range":{"startIndex":23250,"endIndex":24529,"tabId":"t.0"},"textStyle":{},"fields":"bold,italic,underline,link,weightedFontFamily,foregroundColor,baselineOffset"}},{"updateParagraphStyle":{"range":{"startIndex":23250,"endIndex":24529,"tabId":"t.0"},"paragraphStyle":{"namedStyleType":"NORMAL_TEXT"},"fields":"namedStyleType"}},{"insertText":{"location":{"index":24529,"tabId":"t.0"},"text":"\n"}},{"updateParagraphStyle":{"range":{"startIndex":24529,"endIndex":24530,"tabId":"t.0"},"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"CENTER"},"fields":"namedStyleType,alignment"}},{"insertInlineImage":{"location":{"index":24529,"tabId":"t.0"},"uri":"https://raw.githubusercontent.com/ConstantinVictorBeatErtel/RAID/84e380715ea4bbb698c07e7ada226ac0857a5a74/paper/figures/fig5_compute.png","objectSize":{"width":{"magnitude":468,"unit":"PT"},"height":{"magnitude":640,"unit":"PT"}}}},{"insertText":{"location":{"index":24531,"tabId":"t.0"},"text":"Figure 5. Final tasks, MAE: chunk MSE against cumulative adaptation GPU-seconds. RAID v8 starts lowest; encoder tuning reaches the lowest error with one to two orders of magnitude more GPU-seconds.\n6.4 In closed loop, the adapted head beats fine-tuning, but k-NN completes the most tasks\nTable 4. Closed-loop success with recorded target frames (20 episodes per task, seed 42, MAE, rounded gripper), with a 95% bootstrap interval over the 30 tasks.\n"}},{"updateTextStyle":{"range":{"startIndex":24531,"endIndex":24980,"tabId":"t.0"},"textStyle":{},"fields":"bold,italic,underline,link,weightedFontFamily,foregroundColor,baselineOffset"}},{"updateParagraphStyle":{"range":{"startIndex":24531,"endIndex":24980,"tabId":"t.0"},"paragraphStyle":{"namedStyleType":"NORMAL_TEXT"},"fields":"namedStyleType"}},{"updateParagraphStyle":{"range":{"startIndex":24729,"endIndex":24819,"tabId":"t.0"},"paragraphStyle":{"namedStyleType":"HEADING_2"},"fields":"namedStyleType"}}]