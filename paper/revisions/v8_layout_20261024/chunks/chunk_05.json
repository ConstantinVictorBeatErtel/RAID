ex":0},"rowSpan":1,"columnSpan":6},"tableCellStyle":{"backgroundColor":{"color":{"rgbColor":{"red":0.92156863,"green":0.9411765,"blue":0.96862745}}}},"fields":"backgroundColor"}},{"insertText":{"location":{"index":25483,"tabId":"t.0"},"text":"The disagreement-aware gate also helped in closed loop: without training, RAID v8 succeeded in 17% of episodes against 5% for RAID v7 (paired difference +0.125, 95% CI [+0.04, +0.22], better on 18 tasks and worse on 5). After 25 updates, RAID v8 succeeded in 38% of episodes against 16% for head-only fine-tuning (+0.22 [+0.10, +0.34], better on 20 tasks and worse on 4), and it was ahead of LoRA (31%) and full fine-tuning (27%) after 200 updates, although the difference to LoRA was not clear (+0.07 [−0.02, +0.17]). Plain k-NN, however, succeeded most often (44%); the difference to RAID v8 after 25 updates was −0.06 [−0.17, +0.05], better on 10 tasks and worse on 16 (Figure 6). These closed-loop comparisons were not pre-registered as hypotheses.\n"}},{"updateTextStyle":{"range":{"startIndex":25483,"endIndex":26236,"tabId":"t.0"},"textStyle":{},"fields":"bold,italic,underline,link,weightedFontFamily,foregroundColor,baselineOffset"}},{"updateParagraphStyle":{"range":{"startIndex":25483,"endIndex":26236,"tabId":"t.0"},"paragraphStyle":{"namedStyleType":"NORMAL_TEXT"},"fields":"namedStyleType"}},{"insertText":{"location":{"index":26236,"tabId":"t.0"},"text":"\n"}},{"updateParagraphStyle":{"range":{"startIndex":26236,"endIndex":26237,"tabId":"t.0"},"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"CENTER"},"fields":"namedStyleType,alignment"}},{"insertInlineImage":{"location":{"index":26236,"tabId":"t.0"},"uri":"https://raw.githubusercontent.com/ConstantinVictorBeatErtel/RAID/84e380715ea4bbb698c07e7ada226ac0857a5a74/paper/figures/fig6_closed_loop.png","objectSize":{"width":{"magnitude":468,"unit":"PT"},"height":{"magnitude":640,"unit":"PT"}}}}]